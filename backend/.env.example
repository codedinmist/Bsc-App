# Copy to .env and fill in. NEVER commit .env.
PORT=8080
# Public RPC for BNB Smart Chain TESTNET (chain 97)
RPC_URL=https://bsc-testnet-rpc.publicnode.com
# Path to the file written by the contract deploy
DEPLOYMENTS_FILE=../contracts/deployments/bscTestnet.json
# Gas relayer: a NEW wallet used only for this. Fund it with test BNB. TESTNET ONLY.
RELAYER_PRIVATE_KEY=
# Long random string. Needed to read dispute tickets.
ADMIN_TOKEN=
# Limits
RELAY_PER_ADDRESS_PER_DAY=60
RELAY_GLOBAL_PER_DAY=5000
RELAY_MAX_GAS=1500000
# Where the database file lives
DB_FILE=./data/jansetu.db
